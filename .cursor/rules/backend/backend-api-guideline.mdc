## Pagination and Filtering

### Query Parameters
```javascript
// GET /api/v1/orders?page=2&limit=20&status=delivered&sortBy=createdAt&order=desc
router.get('/orders', authenticateJWT, async (req, res, next) => {
  try {
    const { page = 1, limit = 10, status, sortBy = 'created_at', order = 'desc' } = req.query;
    
    const result = await orderService.getOrders({
      page: parseInt(page),
      limit: parseInt(limit),
      status,
      sortBy,
      order,
      userId: req.user.id
    });
    
    res.json({
      success: true,
      data: result.orders,
      pagination: result.pagination
    });
  } catch (error) {
    next(error);
  }
});
```

### Service Implementation
```javascript
async getOrders(options) {
  const { page, limit, status, sortBy, order, userId } = options;
  const skip = (page - 1) * limit;
  
  const where = {
    customer_id: userId,
    ...(status && { order_status: status }),
  };
  
  const [orders, total] = await Promise.all([
    prisma.orders.findMany({
      where,
      skip,
      take: limit,
      orderBy: { [sortBy]: order },
      include: { bills: true },
    }),
    prisma.orders.count({ where }),
  ]);
  
  return {
    orders,
    pagination: {
      page,
      limit,
      total,
      totalPages: Math.ceil(total / limit),
      hasNext: page * limit < total,
      hasPrev: page > 1,
    },
  };
}
```

## Authentication and Authorization

### JWT Authentication
```javascript
// middleware/auth.middleware.js
const jwt = require('jsonwebtoken');
const { UnauthorizedError } = require('../utils/errors');

exports.authenticateJWT = async (req, res, next) => {
  try {
    const authHeader = req.headers.authorization;
    
    if (!authHeader || !authHeader.startsWith('Bearer ')) {
      throw new UnauthorizedError('No token provided');
    }
    
    const token = authHeader.substring(7);
    const decoded = jwt.verify(token, process.env.JWT_SECRET);
    
    // Attach user info to request
    req.user = {
      id: decoded.userId,
      role: decoded.role,
      martId: decoded.martId // for admin users
    };
    
    next();
  } catch (error) {
    if (error.name === 'TokenExpiredError') {
      next(new UnauthorizedError('Token expired'));
    } else if (error.name === 'JsonWebTokenError') {
      next(new UnauthorizedError('Invalid token'));
    } else {
      next(error);
    }
  }
};

// Role-based authorization
exports.authorize = (...allowedRoles) => {
  return (req, res, next) => {
    if (!allowedRoles.includes(req.user.role)) {
      return next(new AppError('Insufficient permissions', 403));
    }
    next();
  };
};
```

### Protected Routes
```javascript
// Public routes (no authentication)
router.post('/auth/register', registerController);
router.post('/auth/login', loginController);
router.get('/health', healthCheckController);

// Customer routes (customer role)
router.get('/orders', authenticateJWT, authorize('customer'), getOrdersController);
router.post('/orders', authenticateJWT, authorize('customer'), createOrderController);

// Admin routes (admin, manager, staff roles)
router.get('/admin/dashboard', authenticateJWT, authorize('admin', 'manager', 'staff'), getDashboardController);
router.patch('/orders/:orderId/status', authenticateJWT, authorize('admin', 'staff'), updateOrderStatusController);

// Delivery partner routes (delivery_partner role)
router.get('/delivery/available', authenticateJWT, authorize('delivery_partner'), getAvailableDeliveriesController);
router.patch('/delivery/:deliveryId/status', authenticateJWT, authorize('delivery_partner'), updateDeliveryStatusController);
```

## Validation

### Request Validation with Joi
```javascript
// validators/order.validator.js
const Joi = require('joi');

exports.createOrderSchema = Joi.object({
  martId: Joi.string().uuid().required(),
  isPerUnitPiece: Joi.boolean().required(),
  pickupRequired: Joi.boolean().default(true),
  pickupScheduledDatetime: Joi.date().iso().when('pickupRequired', {
    is: true,
    then: Joi.required(),
    otherwise: Joi.forbidden()
  }),
  pickupAddressId: Joi.string().uuid().when('pickupRequired', {
    is: true,
    then: Joi.required()
  }),
  dropRequired: Joi.boolean().default(true),
  deliveryAddressId: Joi.string().uuid().when('dropRequired', {
    is: true,
    then: Joi.required()
  }),
  items: Joi.array().items(
    Joi.object({
      itemId: Joi.string().uuid().when('..isPerUnitPiece', {
        is: true,
        then: Joi.required()
      }),
      serviceId: Joi.string().uuid().when('..isPerUnitPiece', {
        is: false,
        then: Joi.required()
      }),
      quantity: Joi.number().positive().required(),
      subtotal: Joi.number().positive().required()
    })
  ).min(1).required()
});

// Apply in route
router.post('/orders',
  authenticateJWT,
  validate(createOrderSchema),
  orderController.createOrder
);
```

## File Upload Handling

### Multer Configuration
```javascript
// middleware/upload.middleware.js
const multer = require('multer');
const path = require('path');
const { AppError } = require('../utils/errors');

// Configure storage
const storage = multer.memoryStorage(); // Store in memory for S3 upload

// File filter
const fileFilter = (req, file, cb) => {
  const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
  
  if (allowedTypes.includes(file.mimetype)) {
    cb(null, true);
  } else {
    cb(new AppError('Invalid file type. Only JPEG, PNG, and WebP are allowed', 400), false);
  }
};

// Multer instance
const upload = multer({
  storage,
  fileFilter,
  limits: {
    fileSize: 5 * 1024 * 1024 // 5MB limit
  }
});

module.exports = upload;
```

### Upload Endpoint
```javascript
// routes/upload.routes.js
const upload = require('../middleware/upload.middleware');
const uploadService = require('../services/upload.service');

// Single file upload
router.post('/upload/proof',
  authenticateJWT,
  upload.single('photo'),
  async (req, res, next) => {
    try {
      if (!req.file) {
        throw new AppError('No file uploaded', 400);
      }
      
      const imageUrl = await uploadService.uploadToS3(
        req.file.buffer,
        req.file.originalname,
        req.file.mimetype,
        'proofs'
      );
      
      res.json({
        success: true,
        data: { imageUrl },
        message: 'File uploaded successfully'
      });
    } catch (error) {
      next(error);
    }
  }
);

// Multiple file upload
router.post('/upload/documents',
  authenticateJWT,
  upload.array('documents', 5), // Max 5 files
  async (req, res, next) => {
    try {
      const uploadPromises = req.files.map(file =>
        uploadService.uploadToS3(file.buffer, file.originalname, file.mimetype, 'documents')
      );
      
      const imageUrls = await Promise.all(uploadPromises);
      
      res.json({
        success: true,
        data: { imageUrls },
        message: 'Files uploaded successfully'
      });
    } catch (error) {
      next(error);
    }
  }
);
```

