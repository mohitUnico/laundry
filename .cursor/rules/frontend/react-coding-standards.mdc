### Avoid `any`

```tsx
// Bad: Using any
const processData = (data: any) => {
  return data.value;
};

// Good: Use specific types
interface DataType {
  value: number;
  label: string;
}

const processData = (data: DataType) => {
  return data.value;
};

// Good: Use unknown for truly unknown types
const parseJson = (json: string): unknown => {
  return JSON.parse(json);
};

// Then narrow the type
const data = parseJson(jsonString);
if (isOrder(data)) {
  // data is now typed as Order
  console.log(data.orderId);
}
```

## React Hooks

### useState

```tsx
// Good: Type inference works
const [count, setCount] = useState(0); // Type: number
const [name, setName] = useState(''); // Type: string

// Good: Explicit typing for complex types
const [order, setOrder] = useState<Order | null>(null);
const [filters, setFilters] = useState<OrderFilters>({
  status: undefined,
  page: 1,
  limit: 10,
});

// Good: Functional updates for state based on previous state
const incrementCount = () => {
  setCount(prevCount => prevCount + 1);
};

// Bad: Direct state mutation
const updateOrder = () => {
  order.status = 'delivered'; // WRONG!
  setOrder(order);
};

// Good: Immutable updates
const updateOrder = () => {
  setOrder(prevOrder => prevOrder ? { ...prevOrder, status: 'delivered' } : null);
};
```

### useEffect

```tsx
// Good: Proper dependencies
useEffect(() => {
  fetchOrders(filters);
}, [filters]); // Re-run when filters change

// Good: Cleanup function
useEffect(() => {
  const timer = setTimeout(() => {
    console.log('Delayed action');
  }, 1000);

  return () => clearTimeout(timer); // Cleanup
}, []);

// Good: Async operations
useEffect(() => {
  let cancelled = false;

  const loadData = async () => {
    try {
      const data = await fetchOrders();
      if (!cancelled) {
        setOrders(data);
      }
    } catch (error) {
      if (!cancelled) {
        setError(error.message);
      }
    }
  };

  loadData();

  return () => {
    cancelled = true; // Prevent state updates after unmount
  };
}, []);

// Bad: Missing dependencies (ESLint will warn)
useEffect(() => {
  fetchOrders(filters);
}, []); // filters is missing from dependencies!
```

### useCallback

```tsx
// Good: Memoize callbacks passed to child components
const OrdersList: React.FC<OrdersListProps> = ({ orders }) => {
  const handleViewDetails = useCallback((orderId: string) => {
    navigate(`/orders/${orderId}`);
  }, [navigate]);

  return (
    <div>
      {orders.map(order => (
        <OrderCard 
          key={order.orderId}
          order={order}
          onViewDetails={handleViewDetails} // Stable reference
        />
      ))}
    </div>
  );
};

// When to use: When passing callbacks to optimized child components (React.memo)
// When not to use: For simple inline handlers that don't cause re-renders
```

### useMemo

```tsx
// Good: Memoize expensive calculations
const OrdersPage: React.FC = () => {
  const [orders, setOrders] = useState<Order[]>([]);
  const [searchTerm, setSearchTerm] = useState('');

  const filteredOrders = useMemo(() => {
    return orders.filter(order =>
      order.orderId.toLowerCase().includes(searchTerm.toLowerCase()) ||
      order.customerName.toLowerCase().includes(searchTerm.toLowerCase())
    );
  }, [orders, searchTerm]); // Recalculate only when these change

  const totalAmount = useMemo(() => {
    return filteredOrders.reduce((sum, order) => sum + order.totalAmount, 0);
  }, [filteredOrders]);

  return (
    <div>
      <input value={searchTerm} onChange={e => setSearchTerm(e.target.value)} />
      <p>Total: ₹{totalAmount}</p>
      <OrdersList orders={filteredOrders} />
    </div>
  );
};

// When to use: For expensive calculations or complex filtering/mapping
// When not to use: For simple operations that are fast
```

### useRef

```tsx
// Good: Access DOM elements
const InputWithFocus: React.FC = () => {
  const inputRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    inputRef.current?.focus();
  }, []);

  return <input ref={inputRef} />;
};

// Good: Store mutable values without causing re-renders
const Timer: React.FC = () => {
  const [count, setCount] = useState(0);
  const intervalRef = useRef<number>();

  const start = () => {
    intervalRef.current = window.setInterval(() => {
      setCount(c => c + 1);
    }, 1000);
  };

  const stop = () => {
    clearInterval(intervalRef.current);
  };

  return (
    <div>
      <p>Count: {count}</p>
      <button onClick={start}>Start</button>
      <button onClick={stop}>Stop</button>
    </div>
  );
};
```

## Custom Hooks

Extract reusable logic into custom hooks:

```tsx
// hooks/useOrders.ts
import { useState, useCallback } from 'react';
import { orderService } from '../services/order.service';
import { Order } from '../types/order.types';

interface UseOrdersReturn {
  orders: Order[];
  loading: boolean;
  error: string | null;
  fetchOrders: (filters?: any) => Promise<void>;
  updateOrderStatus: (orderId: string, status: string) => Promise<void>;
  refreshOrders: () => Promise<void>;
}

export const useOrders = (): UseOrdersReturn => {
  const [orders, setOrders] = useState<Order[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [lastFilters, setLastFilters] = useState<any>(null);

  const fetchOrders = useCallback(async (filters?: any) => {
    setLoading(true);
    setError(null);
    setLastFilters(filters);

    try {
      const response = await orderService.getOrders(filters);
      setOrders(response.data.orders);
    } catch (err: any) {
      setError(err.message || 'Failed to fetch orders');
    } finally {
      setLoading(false);
    }
  }, []);

  const updateOrderStatus = useCallback(async (orderId: string, status: string) => {
    try {
      await orderService.updateOrderStatus(orderId, status);
      // Update local state optimistically
      setOrders(prevOrders =>
        prevOrders.map(order =>
          order.orderId === orderId ? { ...order, orderStatus: status } : order
        )
      );
    } catch (err: any) {
      setError(err.message);
      throw err;
    }
  }, []);

  const refreshOrders = useCallback(async () => {
    if (lastFilters) {
      await fetchOrders(lastFilters);
    }
  }, [lastFilters, fetchOrders]);

  return { orders, loading, error, fetchOrders, updateOrderStatus, refreshOrders };
};

// Usage in component
const OrdersPage: React.FC = () => {
  const { orders, loading, error, fetchOrders } = useOrders();

  useEffect(() => {
    fetchOrders({ status: 'in_process' });
  }, [fetchOrders]);

  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorMessage error={error} />;

  return <OrdersList orders={orders} />;
};
```

**Common Custom Hooks:**
```tsx
// useDebounce.ts
export const useDebounce = <T,>(value: T, delay: number): T => {
  const [debouncedValue, setDebouncedValue] = useState<T>(value);

  useEffect(() => {
    const timer = setTimeout(() => setDebouncedValue(value), delay);
    return () => clearTimeout(timer);
  }, [value, delay]);

  return debouncedValue;
};

// useLocalStorage.ts
export const useLocalStorage = <T,>(key: string, initialValue: T) => {
  const [value, setValue] = useState<T>(() => {
    try {
      const item = window.localStorage.getItem(key);
      return item ? JSON.parse(item) : initialValue;
    } catch {
      return initialValue;
    }
  });

  const setStoredValue = (newValue: T) => {
    setValue(newValue);
    window.localStorage.setItem(key, JSON.stringify(newValue));
  };

  return [value, setStoredValue] as const;
};

// useMediaQuery.ts
export const useMediaQuery = (query: string): boolean => {
  const [matches, setMatches] = useState(false);

  useEffect(() => {
    const media = window.matchMedia(query);
    if (media.matches !== matches) {
      setMatches(media.matches);
    }
    const listener = () => setMatches(media.matches);
    media.addEventListener('change', listener);
    return () => media.removeEventListener('change', listener);
  }, [matches, query]);

  return matches;
};
```

## Performance Optimization

### React.memo

```tsx
// Good: Memoize expensive components
export const OrderCard = React.memo<OrderCardProps>(({ order, onViewDetails }) => {
  return (
    <div className="order-card">
      <h3>{order.orderId}</h3>
      <p>{order.customerName}</p>
      <button onClick={() => onViewDetails(order.orderId)}>View</button>
    </div>
