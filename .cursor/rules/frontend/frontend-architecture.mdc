### Component Architecture

#### Component Types

**1. Page Components**
- Top-level components mapped to routes
- Manage page-level state and data fetching
- Compose smaller components
- Handle authentication and authorization checks

```tsx
// pages/Orders/OrdersListPage.tsx
import React, { useEffect, useState } from 'react';
import { OrdersList } from '../../components/features/orders/OrdersList';
import { OrdersFilters } from '../../components/features/orders/OrdersFilters';
import { useOrders } from '../../hooks/useOrders';

export const OrdersListPage: React.FC = () => {
  const { orders, loading, error, fetchOrders } = useOrders();
  const [filters, setFilters] = useState({});

  useEffect(() => {
    fetchOrders(filters);
  }, [filters]);

  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorMessage error={error} />;

  return (
    <div className="orders-page">
      <PageHeader title="Orders" />
      <OrdersFilters onFilterChange={setFilters} />
      <OrdersList orders={orders} />
    </div>
  );
};
```

**2. Feature Components**
- Domain-specific components (OrdersList, CustomerCard, DeliveryMap)
- Contain feature-specific logic
- Reusable within the same feature domain

```tsx
// components/features/orders/OrderCard.tsx
import React from 'react';
import { Order } from '../../../types/order.types';
import { Badge } from '../../common/Badge';
import { Button } from '../../common/Button';

interface OrderCardProps {
  order: Order;
  onViewDetails: (orderId: string) => void;
}

export const OrderCard: React.FC<OrderCardProps> = ({ order, onViewDetails }) => {
  return (
    <div className="order-card">
      <div className="order-header">
        <span className="order-id">{order.orderId}</span>
        <Badge status={order.orderStatus} />
      </div>
      <div className="order-details">
        <p>Customer: {order.customerName}</p>
        <p>Total: ₹{order.totalAmount}</p>
        <p>Date: {formatDate(order.createdAt)}</p>
      </div>
      <Button onClick={() => onViewDetails(order.orderId)}>
        View Details
      </Button>
    </div>
  );
};
```

**3. Common Components**
- Generic, reusable UI components
- No business logic
- Highly configurable with props
- Examples: Button, Input, Modal, Card, Table

```tsx
// components/common/Button.tsx
import React from 'react';
import classNames from 'classnames';

interface ButtonProps {
  children: React.ReactNode;
  variant?: 'primary' | 'secondary' | 'danger';
  size?: 'small' | 'medium' | 'large';
  disabled?: boolean;
  onClick?: () => void;
  type?: 'button' | 'submit' | 'reset';
}

export const Button: React.FC<ButtonProps> = ({
  children,
  variant = 'primary',
  size = 'medium',
  disabled = false,
  onClick,
  type = 'button',
}) => {
  const className = classNames('btn', {
    [`btn-${variant}`]: variant,
    [`btn-${size}`]: size,
    'btn-disabled': disabled,
  });

  return (
    <button
      type={type}
      className={className}
      onClick={onClick}
      disabled={disabled}
    >
      {children}
    </button>
  );
};
```

#### Component Best Practices

- Use functional components with hooks
- Keep components small and focused (< 200 lines)
- Extract reusable logic into custom hooks
- Use TypeScript for prop type safety
- Implement proper error boundaries
- Optimize with React.memo for expensive components
- Use composition over prop drilling
- Destructure props for cleaner code

### State Management

#### Context API (for simple state)
```tsx
// store/context/AuthContext.tsx
import React, { createContext, useContext, useState, useEffect } from 'react';
import { User } from '../../types/user.types';
import { authService } from '../../services/auth.service';

interface AuthContextType {
  user: User | null;
  loading: boolean;
  login: (email: string, password: string) => Promise<void>;
  logout: () => void;
}

const AuthContext = createContext<AuthContextType | undefined>(undefined);

export const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [user, setUser] = useState<User | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    // Check for existing session
    const checkAuth = async () => {
      try {
        const currentUser = await authService.getCurrentUser();
        setUser(currentUser);
      } catch (error) {
        setUser(null);
      } finally {
        setLoading(false);
      }
    };
    checkAuth();
  }, []);

  const login = async (email: string, password: string) => {
    const user = await authService.login(email, password);
    setUser(user);
  };

  const logout = () => {
    authService.logout();
    setUser(null);
  };

  return (
    <AuthContext.Provider value={{ user, loading, login, logout }}>
      {children}
    </AuthContext.Provider>
  );
};

export const useAuth = () => {
  const context = useContext(AuthContext);
  if (!context) {
    throw new Error('useAuth must be used within AuthProvider');
  }
  return context;
};
```

#### Redux Toolkit (for complex state)
```typescript
// store/slices/ordersSlice.ts
import { createSlice, createAsyncThunk, PayloadAction } from '@reduxjs/toolkit';
import { orderService } from '../../services/order.service';
import { Order } from '../../types/order.types';

interface OrdersState {
  orders: Order[];
  loading: boolean;
  error: string | null;
  filters: {
    status?: string;
    page: number;
    limit: number;
  };
}

const initialState: OrdersState = {
  orders: [],
  loading: false,
  error: null,
  filters: {
    page: 1,
    limit: 10,
  },
};

export const fetchOrders = createAsyncThunk(
  'orders/fetchOrders',
  async (filters: any) => {
    const response = await orderService.getOrders(filters);
    return response.data;
  }
);

const ordersSlice = createSlice({
  name: 'orders',
  initialState,
  reducers: {
    setFilters: (state, action: PayloadAction<any>) => {
      state.filters = { ...state.filters, ...action.payload };
    },
  },
  extraReducers: (builder) => {
    builder
      .addCase(fetchOrders.pending, (state) => {
        state.loading = true;
        state.error = null;
      })
      .addCase(fetchOrders.fulfilled, (state, action) => {
        state.loading = false;
        state.orders = action.payload.orders;
      })
      .addCase(fetchOrders.rejected, (state, action) => {
        state.loading = false;
        state.error = action.error.message || 'Failed to fetch orders';
      });
  },
});

export const { setFilters } = ordersSlice.actions;
export default ordersSlice.reducer;
```

### Custom Hooks Pattern

Extract reusable logic into custom hooks:

```typescript
// hooks/useOrders.ts
import { useState, useCallback } from 'react';
import { orderService } from '../services/order.service';
import { Order } from '../types/order.types';

export const useOrders = () => {
  const [orders, setOrders] = useState<Order[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const fetchOrders = useCallback(async (filters: any) => {
    setLoading(true);
    setError(null);
    try {
      const response = await orderService.getOrders(filters);
      setOrders(response.data.orders);
    } catch (err: any) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  }, []);

  const updateOrderStatus = useCallback(async (orderId: string, status: string) => {
    try {
      await orderService.updateOrderStatus(orderId, status);
      // Update local state
      setOrders(orders.map(order =>
        order.orderId === orderId ? { ...order, orderStatus: status } : order
      ));
    } catch (err: any) {
      setError(err.message);
      throw err;
    }
  }, [orders]);

  return { orders, loading, error, fetchOrders, updateOrderStatus };
};
```

### API Service Layer

```typescript
// services/api.service.ts
import axios, { AxiosInstance, AxiosRequestConfig } from 'axios';

class ApiService {
  private axiosInstance: AxiosInstance;

  constructor() {
    this.axiosInstance = axios.create({
      baseURL: process.env.REACT_APP_API_BASE_URL,
      timeout: 10000,
      headers: {
        'Content-Type': 'application/json',
      },
    });

    // Request interceptor for adding auth token
    this.axiosInstance.interceptors.request.use(
      (config) => {
        const token = localStorage.getItem('authToken');
        if (token) {
          config.headers.Authorization = `Bearer ${token}`;
        }
        return config;
      },
      (error) => Promise.reject(error)
    );

    // Response interceptor for error handling
    this.axiosInstance.interceptors.response.use(
      (response) => response,
      (error) => {
        if (error.response?.status === 401) {
          // Handle unauthorized - redirect to login
          localStorage.removeItem('authToken');
          window.location.href = '/login';
        }
        return Promise.reject(error);
      }
    );
  }

  async get<T>(url: string, config?: AxiosRequestConfig) {
    return this.axiosInstance.get<T>(url, config);
  }

  async post<T>(url: string, data?: any, config?: AxiosRequestConfig) {
    return this.axiosInstance.post<T>(url, data, config);
  }

  async put<T>(url: string, data?: any, config?: AxiosRequestConfig) {
    return this.axiosInstance.put<T>(url, data, config);
  }

  async patch<T>(url: string, data?: any, config?: AxiosRequestConfig) {
    return this.axiosInstance.patch<T>(url, data, config);
  }

  async delete<T>(url: string, config?: AxiosRequestConfig) {
    return this.axiosInstance.delete<T>(url, config);
  }
}

export const apiService = new ApiService();
```

```typescript
// services/order.service.ts
import { apiService } from './api.service';
import { Order, CreateOrderData } from '../types/order.types';

class OrderService {
  private basePath = '/orders';

  async getOrders(filters: any) {
    return apiService.get<{ orders: Order[] }>(this.basePath, { params: filters });
  }

  async getOrderById(orderId: string) {
    return apiService.get<{ order: Order }>(`${this.basePath}/${orderId}`);
  }

  async createOrder(data: CreateOrderData) {
    return apiService.post<{ order: Order }>(this.basePath, data);
  }

  async updateOrderStatus(orderId: string, status: string) {
    return apiService.patch<{ order: Order }>(
      `${this.basePath}/${orderId}/status`,
      { status }
    );
  }
}

export const orderService = new OrderService();
```

