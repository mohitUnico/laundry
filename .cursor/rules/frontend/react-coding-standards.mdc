## Component Structure

### Functional Components

**Basic Structure:**
```tsx
import React from 'react';
import { SomeType } from '../../types/some.types';
import './ComponentName.styles.css';

interface ComponentNameProps {
  prop1: string;
  prop2: number;
  onAction?: () => void;
}

export const ComponentName: React.FC<ComponentNameProps> = ({
  prop1,
  prop2,
  onAction,
}) => {
  // 1. Hooks
  const [state, setState] = useState<string>('');
  const customHook = useCustomHook();

  // 2. Event Handlers
  const handleClick = () => {
    console.log('clicked');
    onAction?.();
  };

  // 3. Effects
  useEffect(() => {
    // Effect logic
  }, [dependencies]);

  // 4. Helper functions (or extract to utils)
  const formatValue = (value: string) => {
    return value.toUpperCase();
  };

  // 5. Early returns
  if (!prop1) {
    return <div>Loading...</div>;
  }

  // 6. JSX
  return (
    <div className="component-name">
      <h2>{formatValue(prop1)}</h2>
      <button onClick={handleClick}>Action</button>
    </div>
  );
};
```

### Component Best Practices

**1. Props Interface**
```tsx
// Good: Clear interface with optional props marked
interface OrderCardProps {
  order: Order;
  onViewDetails: (orderId: string) => void;
  onEdit?: (orderId: string) => void;
  showActions?: boolean;
  className?: string;
}

// Bad: Unclear types
interface OrderCardProps {
  data: any;
  onClick: Function;
}
```

**2. Destructuring Props**
```tsx
// Good: Destructure in function signature
export const OrderCard: React.FC<OrderCardProps> = ({
  order,
  onViewDetails,
  showActions = true,
}) => {
  return (
    <div>
      <h3>{order.orderId}</h3>
      {showActions && <button onClick={() => onViewDetails(order.orderId)}>View</button>}
    </div>
  );
};

// Bad: Access props directly
export const OrderCard: React.FC<OrderCardProps> = (props) => {
  return (
    <div>
      <h3>{props.order.orderId}</h3>
      <button onClick={() => props.onViewDetails(props.order.orderId)}>View</button>
    </div>
  );
};
```

**3. Default Props**
```tsx
// Good: Default values in destructuring
export const Pagination: React.FC<PaginationProps> = ({
  page = 1,
  limit = 10,
  onPageChange,
}) => {
  // ...
};

// Or use defaultProps for class components (legacy)
```

**4. Children Prop**
```tsx
// Good: Properly typed children
interface CardProps {
  title: string;
  children: React.ReactNode;
}

export const Card: React.FC<CardProps> = ({ title, children }) => {
  return (
    <div className="card">
      <h3>{title}</h3>
      <div className="card-body">{children}</div>
    </div>
  );
};

// Usage
<Card title="Order Details">
  <OrderInfo order={order} />
</Card>
```

## TypeScript Best Practices

### Type Definitions

**Component Props:**
```tsx
// Define clear interfaces for props
interface ButtonProps {
  variant: 'primary' | 'secondary' | 'danger';
  size: 'small' | 'medium' | 'large';
  disabled?: boolean;
  loading?: boolean;
  onClick?: (event: React.MouseEvent<HTMLButtonElement>) => void;
  children: React.ReactNode;
  type?: 'button' | 'submit' | 'reset';
  className?: string;
}

// Use Pick/Omit for derived types
type IconButtonProps = Omit<ButtonProps, 'children'> & {
  icon: React.ReactNode;
};

// Extend HTML element props
interface InputProps extends React.InputHTMLAttributes<HTMLInputElement> {
  label: string;
  error?: string;
}
```

