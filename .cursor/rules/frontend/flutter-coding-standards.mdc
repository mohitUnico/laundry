## Data Models

### Model Class Structure

```dart
// models/order.dart
class Order {
  final String orderId;
  final String martId;
  final String customerId;
  final String customerName;
  final OrderStatus orderStatus;
  final double totalAmount;
  final DateTime createdAt;
  final List<OrderItem> items;

  const Order({
    required this.orderId,
    required this.martId,
    required this.customerId,
    required this.customerName,
    required this.orderStatus,
    required this.totalAmount,
    required this.createdAt,
    required this.items,
  });

  // Factory constructor for JSON deserialization
  factory Order.fromJson(Map<String, dynamic> json) {
    return Order(
      orderId: json['orderId'] as String,
      martId: json['martId'] as String,
      customerId: json['customerId'] as String,
      customerName: json['customerName'] as String,
      orderStatus: OrderStatus.values.firstWhere(
        (e) => e.name == json['orderStatus'],
      ),
      totalAmount: (json['totalAmount'] as num).toDouble(),
      createdAt: DateTime.parse(json['createdAt'] as String),
      items: (json['items'] as List)
          .map((item) => OrderItem.fromJson(item as Map<String, dynamic>))
          .toList(),
    );
  }

  // Method for JSON serialization
  Map<String, dynamic> toJson() {
    return {
      'orderId': orderId,
      'martId': martId,
      'customerId': customerId,
      'customerName': customerName,
      'orderStatus': orderStatus.name,
      'totalAmount': totalAmount,
      'createdAt': createdAt.toIso8601String(),
      'items': items.map((item) => item.toJson()).toList(),
    };
  }

  // copyWith method for immutable updates
  Order copyWith({
    String? orderId,
    String? martId,
    String? customerId,
    String? customerName,
    OrderStatus? orderStatus,
    double? totalAmount,
    DateTime? createdAt,
    List<OrderItem>? items,
  }) {
    return Order(
      orderId: orderId ?? this.orderId,
      martId: martId ?? this.martId,
      customerId: customerId ?? this.customerId,
      customerName: customerName ?? this.customerName,
      orderStatus: orderStatus ?? this.orderStatus,
      totalAmount: totalAmount ?? this.totalAmount,
      createdAt: createdAt ?? this.createdAt,
      items: items ?? this.items,
    );
  }

  @override
  bool operator ==(Object other) {
    if (identical(this, other)) return true;
    return other is Order && other.orderId == orderId;
  }

  @override
  int get hashCode => orderId.hashCode;

  @override
  String toString() => 'Order(orderId: $orderId, status: $orderStatus)';
}

enum OrderStatus {
  pickup,
  inProcess,
  ready,
  outForDelivery,
  delivered,
}

extension OrderStatusExtension on OrderStatus {
  String get displayName {
    switch (this) {
      case OrderStatus.pickup:
        return 'Pickup';
      case OrderStatus.inProcess:
        return 'In Process';
      case OrderStatus.ready:
        return 'Ready';
      case OrderStatus.outForDelivery:
        return 'Out for Delivery';
      case OrderStatus.delivered:
        return 'Delivered';
    }
  }

  Color get color {
    switch (this) {
      case OrderStatus.pickup:
        return Colors.orange;
      case OrderStatus.inProcess:
        return Colors.blue;
      case OrderStatus.ready:
        return Colors.green;
      case OrderStatus.outForDelivery:
        return Colors.purple;
      case OrderStatus.delivered:
        return Colors.grey;
    }
  }
}
```

## API Services

### API Service Structure

```dart
// services/api_service.dart
import 'package:dio/dio.dart';
import '../utils/storage.dart';

class ApiService {
  late final Dio _dio;

  ApiService() {
    _dio = Dio(
      BaseOptions(
        baseUrl: 'https://api.laundryapp.com/api/v1',
        connectTimeout: const Duration(seconds: 10),
        receiveTimeout: const Duration(seconds: 10),
        headers: {
          'Content-Type': 'application/json',
        },
      ),
    );

    // Request interceptor
    _dio.interceptors.add(
      InterceptorsWrapper(
        onRequest: (options, handler) async {
          final token = await Storage.getAuthToken();
          if (token != null) {
            options.headers['Authorization'] = 'Bearer $token';
          }
          return handler.next(options);
        },
        onError: (error, handler) async {
          if (error.response?.statusCode == 401) {
            await Storage.removeAuthToken();
            // Navigate to login (implement your navigation logic)
          }
          return handler.next(error);
        },
      ),
    );
  }

  Future<Response<T>> get<T>(
    String path, {
    Map<String, dynamic>? queryParameters,
  }) {
    return _dio.get<T>(path, queryParameters: queryParameters);
  }

  Future<Response<T>> post<T>(
    String path, {
    dynamic data,
  }) {
    return _dio.post<T>(path, data: data);
  }

  Future<Response<T>> put<T>(
    String path, {
    dynamic data,
  }) {
    return _dio.put<T>(path, data: data);
  }

  Future<Response<T>> patch<T>(
    String path, {
    dynamic data,
  }) {
    return _dio.patch<T>(path, data: data);
  }

  Future<Response<T>> delete<T>(String path) {
    return _dio.delete<T>(path);
  }
}
```

### Domain Service

```dart
// services/order_service.dart
import '../models/order.dart';
import 'api_service.dart';

class OrderService {
  final ApiService _apiService = ApiService();

  Future<List<Order>> getOrders({Map<String, dynamic>? filters}) async {
    try {
      final response = await _apiService.get<Map<String, dynamic>>(
        '/orders',
        queryParameters: filters,
      );

      final ordersJson = response.data!['data'] as List;
      return ordersJson
          .map((json) => Order.fromJson(json as Map<String, dynamic>))
          .toList();
    } catch (e) {
      throw Exception('Failed to fetch orders: $e');
    }
  }

  Future<Order> getOrderById(String orderId) async {
    try {
      final response = await _apiService.get<Map<String, dynamic>>(
        '/orders/$orderId',
      );

      return Order.fromJson(response.data!['data'] as Map<String, dynamic>);
    } catch (e) {
      throw Exception('Failed to fetch order: $e');
    }
  }

  Future<Order> createOrder(Map<String, dynamic> orderData) async {
    try {
      final response = await _apiService.post<Map<String, dynamic>>(
        '/orders',
        data: orderData,
      );

      return Order.fromJson(response.data!['data'] as Map<String, dynamic>);
    } catch (e) {
      throw Exception('Failed to create order: $e');
    }
  }

  Future<void> updateOrderStatus(String orderId, String status) async {
    try {
      await _apiService.patch<Map<String, dynamic>>(
        '/orders/$orderId/status',
        data: {'status': status},
      );
    } catch (e) {
      throw Exception('Failed to update order status: $e');
    }
  }
}
```

## Navigation

### Route Configuration

```dart
// routes/app_routes.dart
import 'package:flutter/material.dart';
import '../screens/auth/login_screen.dart';
import '../screens/home/home_screen.dart';
import '../screens/orders/orders_list_screen.dart';
import '../screens/orders/order_details_screen.dart';

class AppRoutes {
  static const String login = '/login';
  static const String home = '/home';
  static const String orders = '/orders';
  static const String orderDetails = '/order-details';
  static const String createOrder = '/create-order';

  static Route<dynamic> generateRoute(RouteSettings settings) {
    switch (settings.name) {
      case login:
        return MaterialPageRoute(builder: (_) => const LoginScreen());
      
      case home:
        return MaterialPageRoute(builder: (_) => const HomeScreen());
      
      case orders:
        return MaterialPageRoute(builder: (_) => const OrdersListScreen());
      
      case orderDetails:
        final orderId = settings.arguments as String;
        return MaterialPageRoute(
          builder: (_) => OrderDetailsScreen(orderId: orderId),
        );
      
      case createOrder:
        return MaterialPageRoute(builder: (_) => const CreateOrderScreen());
      
      default:
        return MaterialPageRoute(
          builder: (_) => Scaffold(
            body: Center(
              child: Text('No route defined for ${settings.name}'),
            ),
          ),
        );
    }
  }
}

// Usage in main.dart
class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Laundry App',
      initialRoute: AppRoutes.login,
      onGenerateRoute: AppRoutes.generateRoute,
    );
  }
}
```

