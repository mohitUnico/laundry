# =============================================================================
# Local development stack: PostgreSQL (Docker) + Redis + Cloudinary uploads
# Mobile apps on same Wi-Fi: use http://<YOUR_LAN_IP>:3001/api/v1
# =============================================================================

# Database (Docker Compose service name "postgres" from backend container)
DATABASE_URL="postgresql://laundry_user:laundry_pass@postgres:5432/laundry_db?connection_limit=10&pool_timeout=20"
# Same as DATABASE_URL for local Postgres (required by Prisma schema)
DIRECT_URL="postgresql://laundry_user:laundry_pass@postgres:5432/laundry_db"

# When running Prisma CLI on host (outside Docker), use:
# DATABASE_URL="postgresql://laundry_user:laundry_pass@localhost:5432/laundry_db"
# DIRECT_URL="postgresql://laundry_user:laundry_pass@localhost:5432/laundry_db"

# Cloudinary (file uploads — profile images, documents, delivery proofs)
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional root folder prefix in Cloudinary
CLOUDINARY_UPLOAD_FOLDER=laundry-app

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production-use-64-random-bytes"
JWT_EXPIRY="7d" # Access token expiry (7 days)

# Refresh Token Configuration
REFRESH_TOKEN_EXPIRY_DAYS=90 # Refresh token validity (90 days)
REFRESH_TOKEN_BYTES=48 # Random bytes for refresh token generation

# SMTP Email Configuration (required for sending OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Force real SMTP mode (must remain false for production)
MOCK_EMAIL=false
# Optional aliases / overrides
# EMAIL_SERVICE=gmail
FROM_EMAIL="Laundry App <your-email@gmail.com>"
# SMTP_FROM_EMAIL overrides FROM_EMAIL when provided

# Server Configuration
PORT=5000
NODE_ENV=development

# Logging Configuration
LOG_LEVEL=debug

# Firebase (FCM) - Push Notifications
# Enable Firebase Admin for sending push notifications to mobile apps
FIREBASE_ENABLED=false
# Path to Firebase service account JSON file (relative to backend/ root, or absolute)
# Example: FIREBASE_SERVICE_ACCOUNT_PATH="src/config/firebase-service-account.json"
FIREBASE_SERVICE_ACCOUNT_PATH="src/config/firebase-service-account.json"

# CORS Configuration (comma-separated origins)
# Add your LAN IP for mart-admin / web testing, e.g. http://192.168.1.10:5173
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:5173"

# Client polling intervals (ms) — replaces Supabase Realtime
POLLING_ORDERS_MS=15000
POLLING_COUPONS_MS=30000
POLLING_TRACKING_MS=5000
POLLING_DELIVERY_HOME_MS=15000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Twilio SMS Configuration (Optional - for OTP SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+919876543210

# WhatsApp Notifications (order updates) - see docs/WHATSAPP_SETUP.md
WHATSAPP_ENABLED=false
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_ORDER_UPDATE_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OTP Configuration (optional - uses defaults if not set)
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_SECONDS=60

# Portal Login OTP Configuration (optional)
PORTAL_OTP_EXPIRY_MINUTES=5
PORTAL_OTP_CLEANUP_INTERVAL_MS=300000

# Pickup assignment scheduler (BullMQ + Redis)
PICKUP_ASSIGNMENT_USE_QUEUE=true

# Redis — Docker Compose: redis://redis:6379 | Host + Docker Redis: redis://127.0.0.1:6379
REDIS_URL=redis://redis:6379

# Catch-up job (re-queues eligible orders if Redis restarts)
# PICKUP_ASSIGNMENT_CATCHUP_ENABLED=true
# PICKUP_ASSIGNMENT_CATCHUP_INTERVAL_MS=300000

# Scheduled jobs
# DAILY_METRICS_JOB_ENABLED=false
# DAILY_METRICS_LOGS_ENABLED=false
