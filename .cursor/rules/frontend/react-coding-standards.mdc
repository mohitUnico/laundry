## Testing

### Component Tests

```tsx
// OrderCard.test.tsx
import { render, screen, fireEvent } from '@testing-library/react';
import { OrderCard } from './OrderCard';

const mockOrder: Order = {
  orderId: 'order-123',
  customerName: 'John Doe',
  orderStatus: 'in_process',
  totalAmount: 150,
  // ... other fields
};

describe('OrderCard', () => {
  it('renders order information', () => {
    render(<OrderCard order={mockOrder} onViewDetails={jest.fn()} />);
    
    expect(screen.getByText('order-123')).toBeInTheDocument();
    expect(screen.getByText('John Doe')).toBeInTheDocument();
    expect(screen.getByText('₹150')).toBeInTheDocument();
  });

  it('calls onViewDetails when button is clicked', () => {
    const handleViewDetails = jest.fn();
    render(<OrderCard order={mockOrder} onViewDetails={handleViewDetails} />);
    
    fireEvent.click(screen.getByText('View Details'));
    
    expect(handleViewDetails).toHaveBeenCalledWith('order-123');
  });

  it('displays status badge with correct style', () => {
    render(<OrderCard order={mockOrder} onViewDetails={jest.fn()} />);
    
    const badge = screen.getByText('in_process');
    expect(badge).toHaveClass('badge-in-process');
  });
});
```

## Best Practices Summary

1. **Use Functional Components**: Always use functional components with hooks
2. **TypeScript**: Use TypeScript for type safety
3. **Component Size**: Keep components small and focused (< 200 lines)
4. **Custom Hooks**: Extract reusable logic into custom hooks
5. **Performance**: Use React.memo, useMemo, useCallback appropriately
6. **Error Handling**: Implement error boundaries and proper error states
7. **Accessibility**: Use semantic HTML and ARIA attributes
8. **Code Splitting**: Lazy load routes and heavy components
9. **Testing**: Write tests for components and custom hooks
10. **Consistent Styling**: Use CSS Modules or styled-components consistently
