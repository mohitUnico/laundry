## Code Structure

### Function Declaration
```javascript
// Good: Use arrow functions for simple functions
const add = (a, b) => a + b;

const calculateTotal = (items) => {
  return items.reduce((sum, item) => sum + item.price, 0);
};

// Good: Use function keyword for complex functions or methods
function processOrder(order) {
  // Complex logic
  validateOrder(order);
  calculatePricing(order);
  applyDiscounts(order);
  return finalizeOrder(order);
}

// Good: Use async/await for asynchronous operations
async function fetchUserOrders(userId) {
  try {
    const orders = await prisma.orders.findMany({
      where: { customer_id: userId }
    });
    return orders;
  } catch (error) {
    logger.error('Failed to fetch orders', error);
    throw new AppError('Unable to retrieve orders', 500);
  }
}
```

### Module Exports
```javascript
// Good: Named exports for multiple exports
// order-service.js
exports.createOrder = async (orderData) => { /* ... */ };
exports.getOrderById = async (orderId) => { /* ... */ };
exports.updateOrderStatus = async (orderId, status) => { /* ... */ };

// Or using ES6 modules
export const createOrder = async (orderData) => { /* ... */ };
export const getOrderById = async (orderId) => { /* ... */ };

// Good: Default export for single export
// logger.js
const logger = winston.createLogger({ /* ... */ });
module.exports = logger;

// Or ES6
export default logger;
```

