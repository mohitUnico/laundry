generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== LAUNDRY CONFIGURATION ====================
// Single laundry business configuration
model LaundryConfig {
  config_id         String   @id @default(uuid())
  business_name     String   @db.VarChar(255)
  contact_email     String   @unique @db.VarChar(255)
  contact_phone     String   @db.VarChar(20)
  address           String
  latitude          Decimal  @db.Decimal(10, 8)
  longitude         Decimal  @db.Decimal(11, 8)
  service_radius_km Json // Distance-based delivery fee configuration
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  logo_url          String?

  @@map("laundry_config")
}

// ==================== USER MANAGEMENT ====================

// Admin/Owner - Single admin for the laundry business
model User {
  user_id    String   @id @default(uuid())
  full_name  String   @db.VarChar(255)
  email      String   @unique @db.VarChar(255)
  phone      String?  @db.VarChar(20)
  password   String?  @db.VarChar(255)
  role       UserRole @default(admin)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([role])
  @@map("users")
}

enum UserRole {
  admin
  owner
}

// Customer
model Customer {
  customer_id       String            @id @default(uuid())
  full_name         String            @db.VarChar(255)
  email             String            @unique @db.VarChar(255)
  phone             String?           @db.VarChar(20)
  password          String?           @db.VarChar(255)
  profile_image_url String?           @db.VarChar(500)
  // Firebase Cloud Messaging token (one device token for now; can be extended to a separate table later)
  fcm_token         String?           @db.VarChar(255)
  is_active         Boolean           @default(true)
  total_orders      Int               @default(0)
  total_spent       Decimal           @default(0) @db.Decimal(10, 2)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  addresses         CustomerAddress[]
  orders            Order[]
  carts             Cart[]
  notifications     CustomerNotification[]

  @@map("customers")
}

model CustomerAddress {
  address_id      String   @id @default(uuid())
  customer_id     String
  address_label   String   @db.VarChar(50)
  full_address    String
  latitude        Decimal  @db.Decimal(10, 8)
  longitude       Decimal  @db.Decimal(11, 8)
  is_default      Boolean  @default(false)
  delivery_note   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  customer        Customer @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  delivery_orders Order[]  @relation("DeliveryAddress")
  pickup_orders   Order[]  @relation("PickupAddress")

  @@index([customer_id])
  @@index([customer_id, is_default, updated_at])
  @@map("customer_addresses")
}

// Delivery Partner/Staff
model DeliveryStaff {
  staff_id                     String                        @id @default(uuid())
  full_name                    String                        @db.VarChar(255)
  phone                        String?                       @db.VarChar(20)
  email                        String                        @unique @db.VarChar(255)
  // Firebase Cloud Messaging token for push notifications
  fcm_token                    String?                       @db.VarChar(255)
  // Delivery partner current address & location (captured during registration)
  address                      String?                       @db.VarChar(500)
  current_latitude             Decimal?                      @db.Decimal(10, 8)
  current_longitude            Decimal?                      @db.Decimal(11, 8)
  vehicle_type                 String                        @db.VarChar(50)
  vehicle_number               String                        @db.VarChar(50)
  profile_image_url            String?                       @db.VarChar(500) // Partner profile/selfie image URL
  id_proof_type                String?                       @db.VarChar(50) // Aadhaar, etc.
  id_proof_url                 String?                       @db.VarChar(500)
  driving_license_url          String?                       @db.VarChar(500) // Driving license file URL
  bank_account_details         Json?
  verification_status          VerificationStatus            @default(pending)
  is_verified_by_admin         Boolean                       @default(false)
  is_active                    Boolean                       @default(true)
  average_rating               Decimal?                      @db.Decimal(3, 2)
  total_deliveries             Int                           @default(0)
  created_at                   DateTime                      @default(now())
  updated_at                   DateTime                      @updatedAt
  deliveries                   Delivery[]
  deliveryStaffShifts          DeliveryStaffShift[]
  deliveryStaffLocations       DeliveryStaffLocation[]
  deliveryAssignmentRequests   DeliveryAssignmentRequest[]
  deliveryStaffNotifications   DeliveryStaffNotification[]
  deliveryAssignmentRecipients DeliveryAssignmentRecipient[]

  @@index([verification_status])
  @@index([is_verified_by_admin])
  @@map("delivery_staffs")
}

enum VerificationStatus {
  pending
  verified
  rejected
}

// Unified Staff table for Collection Manager, Distribution Manager, and Service Man
model Staff {
  staff_id   String    @id @default(uuid())
  role       StaffRole
  full_name  String    @db.VarChar(255)
  email      String    @unique @db.VarChar(255) // Unique across ALL staff roles
  phone      String?   @db.VarChar(20)
  is_active  Boolean   @default(true)
  // Only service men have service_id; unique allows at most 1 service man per service (NULL allowed for other roles)
  service_id String?   @unique
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  service Service? @relation(fields: [service_id], references: [service_id])

  // Orders received by staff (collection manager role)
  orders_received Order[] @relation("ReceivedByStaff")

  // Service queue items assigned to staff (service man role)
  service_queue_items ServiceQueueItem[] @relation("ServiceQueueAssignedStaff")

  @@index([role])
  @@index([service_id])
  @@map("staff")
}

enum StaffRole {
  collection_manager
  distribution_manager
  service_man
}

// ==================== SERVICE CATALOG ====================

model ServiceCategory {
  category_id      String    @id @default(uuid())
  category_name    String    @db.VarChar(100)
  description      String?
  icon_url         String?   @db.VarChar(500)
  foreground_color String    @default("2841CF") @db.VarChar(6)
  background_color String    @default("FFFFFF") @db.VarChar(6)
  display_order    Int       @default(0)
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  services         Service[]

  @@index([is_active, display_order])
  @@map("service_categories")
}

model Service {
  service_id      String          @id @default(uuid())
  category_id     String
  service_name    String          @db.VarChar(255)
  description     String?
  base_price      Decimal         @db.Decimal(10, 2)
  per_kg_price    Decimal?        @db.Decimal(10, 2)
  estimated_hours Int
  icon_url        String?         @db.VarChar(500)
  includes        String[]        @default([])
  excludes        String[]        @default([])
  is_active       Boolean         @default(true)
  display_order   Int             @default(0)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  category        ServiceCategory @relation(fields: [category_id], references: [category_id])
  clothes_items   ClothesItem[]
  service_man     Staff? // One service man per service (Staff.role = service_man)

  // Cart items for this service
  cart_items CartItem[]

  // Order items for this service
  order_items OrderItem[]

  // Service queue items
  service_queue_items ServiceQueueItem[]

  @@index([category_id])
  @@index([category_id, is_active, display_order])
  @@map("services")
}

model ClothesItem {
  cloth_id       String      @id @default(uuid())
  service_id     String
  item_name      String      @db.VarChar(100)
  per_unit_price Decimal     @db.Decimal(10, 2)
  icon_url       String?     @db.VarChar(500)
  is_active      Boolean     @default(true)
  display_order  Int         @default(0)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  service        Service     @relation(fields: [service_id], references: [service_id])
  order_items    OrderItem[]

  // Order item selections
  order_item_selections OrderItemSelection[]

  @@unique([service_id, item_name])
  @@index([service_id])
  @@index([service_id, is_active, display_order])
  @@map("clothes_items")
}

// ==================== CART MANAGEMENT ====================

model Cart {
  cart_id     String     @id @default(uuid())
  customer_id String
  is_active   Boolean    @default(true)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  customer    Customer   @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  cart_items  CartItem[]
  orders      Order[]

  @@index([customer_id])
  @@map("carts")
}

model CartItem {
  cart_item_id String       @id @default(uuid())
  cart_id      String
  service_id   String
  pricing_type PricingModel // per_unit or per_kg
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  cart         Cart         @relation(fields: [cart_id], references: [cart_id], onDelete: Cascade)
  service      Service      @relation(fields: [service_id], references: [service_id])

  @@unique([cart_id, service_id])
  @@index([cart_id])
  @@index([service_id])
  @@map("cart_items")
}

// ==================== ORDER MANAGEMENT ====================

model Order {
  order_id                              String          @id @default(uuid())
  customer_id                           String
  cart_id                               String?
  order_status                          OrderStatus
  is_express                            Boolean         @default(false)
  pickup_mode                           ScheduleMode    @default(instant)
  delivery_mode                         ScheduleMode    @default(instant)
  cancel_reason                         String?
  cancelled_at                          DateTime?
  items_confirmed_at                    DateTime?
  total_amount                          Decimal         @default(0) @db.Decimal(10, 2)
  pickup_address_id                     String
  delivery_address_id                   String
  // Preferred time windows (optional; used for scheduling pickup/drop)
  pickup_time_from                      DateTime?
  pickup_time_to                        DateTime?
  delivery_time_from                    DateTime?
  delivery_time_to                      DateTime?
  special_instructions                  String?
  customer_rating                       Decimal?        @db.Decimal(3, 2)
  customer_review                       String?
  received_by_collection_manager_id     String?
  received_at                           DateTime?
  submitted_to_services_at              DateTime?
  created_at                            DateTime        @default(now())
  updated_at                            DateTime        @updatedAt
  bill                                  Bill?
  deliveries                            Delivery[]
  order_items                           OrderItem[]
  cart                                  Cart?           @relation(fields: [cart_id], references: [cart_id])
  customer                              Customer        @relation(fields: [customer_id], references: [customer_id])
  delivery_address                      CustomerAddress @relation("DeliveryAddress", fields: [delivery_address_id], references: [address_id])
  pickup_address                        CustomerAddress @relation("PickupAddress", fields: [pickup_address_id], references: [address_id])

  // Staff who received the order (collection manager role)
  received_by_manager Staff? @relation("ReceivedByStaff", fields: [received_by_collection_manager_id], references: [staff_id])

  // Service queue items for this order
  service_queue_items        ServiceQueueItem[]
  deliveryAssignmentRequests DeliveryAssignmentRequest[]
  payment_attempts           PaymentAttempt[]

  @@index([customer_id])
  @@index([order_status])
  @@index([order_status, is_express, created_at])
  @@index([created_at])
  @@index([customer_id, created_at])
  @@index([customer_id, order_status, created_at])
  @@index([received_by_collection_manager_id])
  @@map("orders")
}

enum OrderStatus {
  placed
  pickup_assigned
  picked_up
  submitted_to_cm
  received_by_collection
  submitted_to_services
  services_in_progress
  services_completed
  out_for_delivery
  delivered
  cancelled
}

enum PricingModel {
  per_unit
  per_kg
}

enum ScheduleMode {
  instant
  scheduled
}

model OrderItem {
  item_id             String               @id @default(uuid())
  order_id            String
  service_id          String
  pricing_type        PricingModel // per_unit or per_kg
  // For per_unit pricing: clothes_id is required, quantity is sum of selections
  // For per_kg pricing: clothes_id is null, weight_kg is used
  clothes_id          String?
  quantity            Int? // Total quantity for per_unit items (sum of selections)
  weight_kg           Decimal?             @db.Decimal(10, 2) // For per_kg pricing
  unit_price          Decimal?             @db.Decimal(10, 2) // Snapshot at pickup confirm (Phase 5)
  subtotal            Decimal              @default(0) @db.Decimal(10, 2)
  photo_url           String?              @db.VarChar(500) // one photo per service
  item_status         OrderItemStatus      @default(pending)
  assigned_at         DateTime?
  completed_at        DateTime?
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  clothes             ClothesItem?         @relation(fields: [clothes_id], references: [cloth_id])
  service             Service              @relation(fields: [service_id], references: [service_id])
  order               Order                @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  // Individual cloth item selections (for per_unit pricing)
  item_selections     OrderItemSelection[]
  service_queue_items ServiceQueueItem[]

  @@index([order_id])
  @@index([service_id])
  @@index([item_status])
  @@index([pricing_type])
  @@map("order_items")
}

enum OrderItemStatus {
  pending
  in_progress
  completed
}

// Individual cloth item selections within an order item (for per_unit pricing)
// This mirrors CartItemSelection structure for order items
model OrderItemSelection {
  selection_id  String      @id @default(uuid())
  order_item_id String
  cloth_id      String
  quantity      Int
  unit_price    Decimal?    @db.Decimal(10, 2) // snapshot at pickup confirm
  created_at    DateTime    @default(now())
  order_item    OrderItem   @relation(fields: [order_item_id], references: [item_id], onDelete: Cascade)
  cloth_item    ClothesItem @relation(fields: [cloth_id], references: [cloth_id])

  @@index([order_item_id])
  @@index([cloth_id])
  @@map("order_item_selections")
}

// ==================== SERVICE QUEUE (FIFO) ====================

model ServiceQueueItem {
  queue_id       String      @id @default(uuid())
  order_id       String
  service_id     String
  service_man_id String // References Staff.staff_id where Staff.role = service_man
  item_id        String // Reference to OrderItem
  item_name      String      @db.VarChar(255)
  quantity       Int?
  weight_kg      Decimal?    @db.Decimal(10, 2)
  queue_status   QueueStatus @default(pending)
  is_express     Boolean     @default(false)
  assigned_at    DateTime    @default(now())
  started_at     DateTime?
  completed_at   DateTime?
  comments       String?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  order       Order     @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [item_id], references: [item_id], onDelete: Cascade)
  service     Service   @relation(fields: [service_id], references: [service_id])
  service_man Staff     @relation("ServiceQueueAssignedStaff", fields: [service_man_id], references: [staff_id])

  @@index([service_id, queue_status, is_express, assigned_at])
  @@index([service_man_id, queue_status])
  @@index([order_id])
  @@index([service_man_id])
  @@map("service_queue")
}

enum QueueStatus {
  pending
  in_progress
  completed
}

// ==================== BILLING ====================

model Bill {
  bill_id        String        @id @default(uuid())
  order_id       String        @unique
  subtotal       Decimal       @db.Decimal(10, 2)
  delivery_fee   Decimal       @db.Decimal(10, 2)
  tax_amount     Decimal       @db.Decimal(10, 2)
  express_fee    Decimal       @default(0) @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  final_amount   Decimal       @db.Decimal(10, 2)
  coupon_id      Int?
  coupon_code    String?       @db.VarChar(255)
  payment_method String?       @db.VarChar(50) // null until paid
  cash_recorded_by String?     @db.VarChar(100) // delivery staff id when cash is recorded
  payment_status PaymentStatus @default(pending)
  transaction_id String?       @db.VarChar(255)
  paid_at        DateTime?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  order          Order         @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  coupon         Coupon?       @relation(fields: [coupon_id], references: [id])
  payment_attempts PaymentAttempt[]

  @@index([payment_status])
  @@index([created_at])
  @@map("bills")
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

// ==================== DELIVERY MANAGEMENT ====================

model Delivery {
  delivery_id          String                      @id @default(uuid())
  order_id             String
  staff_id             String?
  delivery_type        DeliveryType // pickup or drop
  delivery_status      String                      @db.VarChar(50)
  assigned_at          DateTime                    @default(now())
  completed_at         DateTime?
  delivery_rating      Decimal?                    @db.Decimal(3, 2)
  delivery_review      String?
  delivery_fee         Decimal                     @db.Decimal(10, 2)
  distance_km          Decimal?                    @db.Decimal(10, 2)
  estimated_duration   Int?
  actual_duration      Int?
  created_at           DateTime                    @default(now())
  updated_at           DateTime                    @updatedAt
  order                Order                       @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  staff                DeliveryStaff?              @relation(fields: [staff_id], references: [staff_id])
  drop                 DropForDelivery?
  pickup               PickupForDelivery?
  assignment_requests  DeliveryAssignmentRequest[]

  @@index([staff_id])
  @@index([delivery_status])
  @@index([delivery_type])
  @@index([order_id])
  @@index([order_id, delivery_type])
  @@map("delivery")
}

enum DeliveryType {
  pickup
  drop
}

model PickupForDelivery {
  pickup_id             String    @id @default(uuid())
  delivery_id           String    @unique
  pickup_address        String
  pickup_lat            Decimal   @db.Decimal(10, 8)
  pickup_lng            Decimal   @db.Decimal(11, 8)
  pickup_status         String    @db.VarChar(50)
  // Customer preferred pickup window (optional)
  preferred_pickup_from DateTime?
  preferred_pickup_to   DateTime?
  pickup_time           DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  delivery              Delivery  @relation(fields: [delivery_id], references: [delivery_id], onDelete: Cascade)

  @@index([pickup_status])
  @@map("pickup_for_delivery")
}

model DropForDelivery {
  drop_id             String    @id @default(uuid())
  delivery_id         String    @unique
  drop_address        String
  drop_lat            Decimal   @db.Decimal(10, 8)
  drop_lng            Decimal   @db.Decimal(11, 8)
  drop_status         String    @db.VarChar(50)
  // Customer preferred delivery window (optional)
  preferred_drop_from DateTime?
  preferred_drop_to   DateTime?
  drop_time           DateTime?
  drop_proof          String?   @db.VarChar(500) // Photo proof URL
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  delivery            Delivery  @relation(fields: [delivery_id], references: [delivery_id], onDelete: Cascade)

  @@index([drop_status])
  @@map("drop_for_delivery")
}

// ==================== DELIVERY OPS (SHIFT, LIVE LOCATION, ASSIGNMENT REQUESTS) ====================

model DeliveryStaffShift {
  shift_id         String                  @id @default(uuid())
  staff_id         String
  started_at       DateTime                @default(now())
  ended_at         DateTime?
  is_active        Boolean                 @default(true)
  last_latitude    Decimal?                @db.Decimal(10, 8)
  last_longitude   Decimal?                @db.Decimal(11, 8)
  last_location_at DateTime?
  created_at       DateTime                @default(now())
  updated_at       DateTime                @updatedAt
  staff            DeliveryStaff           @relation(fields: [staff_id], references: [staff_id], onDelete: Cascade)
  locations        DeliveryStaffLocation[]

  @@index([staff_id])
  @@index([is_active])
  @@map("delivery_staff_shifts")
}

model DeliveryStaffLocation {
  location_id String              @id @default(uuid())
  staff_id    String
  shift_id    String?
  latitude    Decimal             @db.Decimal(10, 8)
  longitude   Decimal             @db.Decimal(11, 8)
  recorded_at DateTime            @default(now())
  staff       DeliveryStaff       @relation(fields: [staff_id], references: [staff_id], onDelete: Cascade)
  shift       DeliveryStaffShift? @relation(fields: [shift_id], references: [shift_id], onDelete: SetNull)

  @@index([staff_id, recorded_at])
  @@index([shift_id])
  @@map("delivery_staff_locations")
}

enum DeliveryAssignmentStatus {
  pending
  accepted
  rejected
  expired
  cancelled
}

enum DeliveryAssignmentRecipientStatus {
  pending
  accepted
  rejected
  expired
  cancelled
}

model DeliveryAssignmentRequest {
  request_id     String                   @id @default(uuid())
  order_id       String
  delivery_id    String
  staff_id       String?
  delivery_type  DeliveryType
  status         DeliveryAssignmentStatus @default(pending)
  offered_at     DateTime                 @default(now())
  responded_at   DateTime?
  expires_at     DateTime
  pickup_address String
  pickup_lat     Decimal                  @db.Decimal(10, 8)
  pickup_lng     Decimal                  @db.Decimal(11, 8)
  drop_address   String
  drop_lat       Decimal                  @db.Decimal(10, 8)
  drop_lng       Decimal                  @db.Decimal(11, 8)
  rejection_note String?
  slice_count    Int                      @default(5)
  current_slice  Int                      @default(0)
  max_range_km   Decimal?                 @db.Decimal(8, 2)
  next_slice_at  DateTime?
  ended_reason   String?                  @db.VarChar(30)
  created_at     DateTime                 @default(now())
  updated_at     DateTime                 @updatedAt

  order      Order                         @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  delivery   Delivery                      @relation(fields: [delivery_id], references: [delivery_id], onDelete: Cascade)
  staff      DeliveryStaff?                @relation(fields: [staff_id], references: [staff_id], onDelete: SetNull)
  recipients DeliveryAssignmentRecipient[]

  @@index([order_id])
  @@index([delivery_id])
  @@index([delivery_id, status])
  @@index([staff_id])
  @@index([status])
  @@index([delivery_type])
  @@index([expires_at])
  @@map("delivery_assignment_requests")
}

model DeliveryAssignmentRecipient {
  recipient_id   String                            @id @default(uuid())
  request_id     String
  staff_id       String
  status         DeliveryAssignmentRecipientStatus @default(pending)
  responded_at   DateTime?
  rejection_note String?
  slice_index    Int?
  distance_km    Decimal?                          @db.Decimal(8, 2)
  created_at     DateTime                          @default(now())
  updated_at     DateTime                          @updatedAt

  request DeliveryAssignmentRequest @relation(fields: [request_id], references: [request_id], onDelete: Cascade)
  staff   DeliveryStaff             @relation(fields: [staff_id], references: [staff_id], onDelete: Cascade)

  @@unique([request_id, staff_id])
  @@index([staff_id, status])
  @@index([request_id, status])
  @@map("delivery_assignment_recipients")
}

model DeliveryStaffNotification {
  notification_id String   @id @default(uuid())
  staff_id        String
  type            String   @db.VarChar(50)
  title           String   @db.VarChar(255)
  body            String?
  payload         Json?
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now())

  staff DeliveryStaff @relation(fields: [staff_id], references: [staff_id], onDelete: Cascade)

  @@index([staff_id, created_at])
  @@index([is_read])
  @@map("delivery_staff_notifications")
}

// ==================== ANALYTICS ====================

model DailyMetrics {
  metric_id             String   @id @default(uuid())
  metric_date           DateTime @db.Date
  total_orders          Int      @default(0)
  completed_orders      Int      @default(0)
  cancelled_orders      Int      @default(0)
  total_revenue         Decimal  @default(0) @db.Decimal(10, 2)
  total_customers       Int      @default(0)
  new_customers         Int      @default(0)
  avg_order_value       Decimal  @default(0) @db.Decimal(10, 2)
  completion_rate       Decimal  @default(0) @db.Decimal(5, 2)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  avg_delivery_duration Int?

  @@unique([metric_date])
  @@index([metric_date])
  @@map("daily_metrics")
}

// ==================== OTP VERIFICATION ====================

model OtpVerification {
  otp_id       String   @id @default(uuid())
  otp_code     String   @db.VarChar(6)
  user_type    String   @db.VarChar(30)
  is_verified  Boolean  @default(false)
  expires_at   DateTime
  created_at   DateTime @default(now())
  attempts     Int      @default(0)
  max_attempts Int      @default(5)
  purpose      String   @db.VarChar(50)
  email        String   @db.VarChar(255)

  @@index([email, purpose])
  @@index([expires_at])
  @@index([is_verified])
  @@map("otp_verifications")
}

model OtpSession {
  session_id              String   @id @default(uuid())
  user_type               String   @db.VarChar(30)
  is_new_user             Boolean
  user_id                 String?
  session_token           String   @unique @db.VarChar(500)
  is_completed            Boolean  @default(false)
  expires_at              DateTime
  created_at              DateTime @default(now())
  email                   String   @db.VarChar(255)
  business_email          String?  @db.VarChar(255)
  business_email_verified Boolean  @default(false)

  @@index([email])
  @@index([session_token])
  @@index([expires_at])
  @@map("otp_sessions")
}

// ==================== AUTH SESSION (REFRESH TOKENS) ====================

model RefreshToken {
  token_id             String    @id @default(uuid())
  user_id              String
  user_type            String    @db.VarChar(30)
  token_hash           String    @unique @db.VarChar(64) // sha256 hex
  expires_at           DateTime
  created_at           DateTime  @default(now())
  revoked_at           DateTime?
  replaced_by_token_id String?

  @@index([user_id, user_type])
  @@index([expires_at])
  @@index([revoked_at])
  @@map("refresh_tokens")
}

// ==================== COUPONS ====================
// NOTE: This table lives in Supabase Postgres. We access it via Prisma to avoid
// PostgREST/schema permission issues in some deployments.
model Coupon {
  id              Int      @id @default(autoincrement())
  code            String   @db.VarChar(255)
  description     String?  @db.Text
  discount_type   String   @db.VarChar(50)
  discount_value  Decimal  @db.Decimal(12, 2)
  max_discount    Decimal? @db.Decimal(12, 2)
  min_order_value Decimal? @db.Decimal(12, 2)
  usage_limit     Int?
  usage_per_user  Int?
  valid_from      DateTime?
  valid_till      DateTime?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  bills           Bill[]

  @@index([code])
  @@index([is_active])
  @@map("coupons")
}

enum PaymentAttemptStatus {
  initiated
  pending
  succeeded
  failed
  cancelled
  expired
}

model PaymentAttempt {
  attempt_id      Int                  @id @default(autoincrement())
  order_id        String
  bill_id         String
  provider        String               @db.VarChar(30)
  provider_ref    String?              @db.VarChar(100)
  idempotency_key String               @unique @db.VarChar(100)
  amount          Decimal              @db.Decimal(10, 2)
  status          PaymentAttemptStatus @default(initiated)
  intent_payload  Json?
  failure_reason  String?
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
  order           Order                @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  bill            Bill                 @relation(fields: [bill_id], references: [bill_id], onDelete: Cascade)

  @@index([order_id, status])
  @@index([provider_ref])
  @@map("payment_attempts")
}

model NotificationDelivery {
  id            String   @id @default(uuid())
  order_id      String
  event         String   @db.VarChar(60)
  recipient_key String   @db.VarChar(120)
  channel       String   @db.VarChar(20)
  created_at    DateTime @default(now())

  @@unique([order_id, event, recipient_key, channel])
  @@index([order_id, event])
  @@map("notification_deliveries")
}

// Customer inbox. notification_deliveries only records that a push was sent.
model CustomerNotification {
  notification_id String   @id @default(uuid())
  customer_id     String
  event           String   @db.VarChar(60)
  title           String   @db.VarChar(120)
  order_id        String?
  created_at      DateTime @default(now())
  customer        Customer @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)

  @@index([customer_id, created_at])
  @@map("customer_notifications")
}

// ==================== APP CONFIG (order-flow v2 tunables) ====================

model AppConfig {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?
  updated_by  String?  @db.VarChar(100)
  updated_at  DateTime @updatedAt

  @@map("app_config")
}