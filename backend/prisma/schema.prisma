generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bills {
  bill_id        String        @id
  order_id       String        @unique
  subtotal       Decimal       @db.Decimal(10, 2)
  delivery_fee   Decimal       @db.Decimal(10, 2)
  tax_amount     Decimal       @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  final_amount   Decimal       @db.Decimal(10, 2)
  payment_method String        @db.VarChar(50)
  transaction_id String?       @db.VarChar(255)
  paid_at        DateTime?
  created_at     DateTime      @default(now())
  updated_at     DateTime
  payment_status PaymentStatus @default(pending)
  orders         orders        @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@index([created_at])
  @@index([payment_status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cart_item_selections {
  selection_id  String        @id
  cart_item_id  String
  cloth_id      String
  quantity      Int
  created_at    DateTime      @default(now())
  cart_items    cart_items    @relation(fields: [cart_item_id], references: [cart_item_id], onDelete: Cascade)
  clothes_items clothes_items @relation(fields: [cloth_id], references: [cloth_id])

  @@index([cart_item_id])
  @@index([cloth_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cart_items {
  cart_item_id         String                 @id
  cart_id              String
  service_id           String
  pricing_type         PricingModel
  created_at           DateTime               @default(now())
  updated_at           DateTime
  weight_kg            Decimal?               @db.Decimal(10, 2)
  cart_item_selections cart_item_selections[]
  carts                carts                  @relation(fields: [cart_id], references: [cart_id], onDelete: Cascade)
  services             services               @relation(fields: [service_id], references: [service_id])

  @@index([cart_id])
  @@index([service_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model carts {
  cart_id     String       @id
  customer_id String
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now())
  updated_at  DateTime
  cart_items  cart_items[]
  customers   customers    @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)

  @@index([customer_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model clothes_items {
  item_name             String                  @db.VarChar(100)
  per_unit_price        Decimal                 @db.Decimal(10, 2)
  icon_url              String?                 @db.VarChar(500)
  is_active             Boolean                 @default(true)
  display_order         Int                     @default(0)
  created_at            DateTime                @default(now())
  updated_at            DateTime
  cloth_id              String                  @id
  service_id            String
  cart_item_selections  cart_item_selections[]
  services              services                @relation(fields: [service_id], references: [service_id])
  order_item_selections order_item_selections[]

  @@unique([service_id, item_name])
  @@index([service_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model customer_addresses {
  address_id                                            String    @id
  customer_id                                           String
  address_label                                         String    @db.VarChar(50)
  full_address                                          String
  latitude                                              Decimal   @db.Decimal(10, 8)
  longitude                                             Decimal   @db.Decimal(11, 8)
  is_default                                            Boolean   @default(false)
  delivery_note                                         String?
  created_at                                            DateTime  @default(now())
  updated_at                                            DateTime
  customers                                             customers @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  orders_orders_delivery_address_idTocustomer_addresses orders[]  @relation("orders_delivery_address_idTocustomer_addresses")
  orders_orders_pickup_address_idTocustomer_addresses   orders[]  @relation("orders_pickup_address_idTocustomer_addresses")

  @@index([customer_id])
}

model customer_reviews {
  review_id   String    @id
  order_id    String    @unique
  customer_id String
  rating      Decimal   @db.Decimal(3, 2)
  review      String?
  created_at  DateTime  @default(now())
  updated_at  DateTime
  customers   customers @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  orders      orders    @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@index([customer_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model customers {
  customer_id        String               @id
  full_name          String               @db.VarChar(255)
  email              String               @unique @db.VarChar(255)
  phone              String?              @db.VarChar(20)
  password           String?              @db.VarChar(255)
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now())
  updated_at         DateTime
  total_orders       Int                  @default(0)
  total_spent        Decimal              @default(0) @db.Decimal(10, 2)
  profile_image_url  String?
  carts              carts[]
  customer_addresses customer_addresses[]
  customer_reviews   customer_reviews[]
  orders             orders[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model daily_metrics {
  metric_id             String   @id
  metric_date           DateTime @unique @db.Date
  total_orders          Int      @default(0)
  completed_orders      Int      @default(0)
  cancelled_orders      Int      @default(0)
  total_revenue         Decimal  @default(0) @db.Decimal(10, 2)
  total_customers       Int      @default(0)
  new_customers         Int      @default(0)
  avg_order_value       Decimal  @default(0) @db.Decimal(10, 2)
  completion_rate       Decimal  @default(0) @db.Decimal(5, 2)
  created_at            DateTime @default(now())
  updated_at            DateTime
  avg_delivery_duration Int?

  @@index([metric_date])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model delivery {
  delivery_id          String               @id
  order_id             String               @unique
  staff_id             String
  delivery_status      String               @db.VarChar(50)
  assigned_at          DateTime             @default(now())
  completed_at         DateTime?
  delivery_rating      Decimal?             @db.Decimal(3, 2)
  delivery_review      String?
  delivery_fee         Decimal              @db.Decimal(10, 2)
  distance_km          Decimal?             @db.Decimal(10, 2)
  estimated_duration   Int?
  actual_duration      Int?
  created_at           DateTime             @default(now())
  updated_at           DateTime
  delivery_type        DeliveryType
  needs_weight_machine Boolean              @default(false)
  orders               orders               @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  delivery_staffs      delivery_staffs      @relation(fields: [staff_id], references: [staff_id])
  drop_for_delivery    drop_for_delivery?
  pickup_for_delivery  pickup_for_delivery?

  @@index([delivery_status])
  @@index([delivery_type])
  @@index([staff_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model delivery_staffs {
  staff_id             String             @id
  full_name            String             @db.VarChar(255)
  phone                String?            @db.VarChar(20)
  email                String             @unique @db.VarChar(255)
  password             String?            @db.VarChar(255)
  vehicle_type         String             @db.VarChar(50)
  vehicle_number       String             @db.VarChar(50)
  license_number       String             @db.VarChar(50)
  document_url         String?            @db.VarChar(500)
  bank_account_details Json?
  is_active            Boolean            @default(true)
  average_rating       Decimal?           @db.Decimal(3, 2)
  total_deliveries     Int                @default(0)
  created_at           DateTime           @default(now())
  updated_at           DateTime
  id_proof_type        String?            @db.VarChar(50)
  id_proof_url         String?            @db.VarChar(500)
  is_verified_by_admin Boolean            @default(false)
  verification_status  VerificationStatus @default(pending)
  delivery             delivery[]

  @@index([is_verified_by_admin])
  @@index([verification_status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model drop_for_delivery {
  drop_id      String    @id
  delivery_id  String    @unique
  drop_address String
  drop_lat     Decimal   @db.Decimal(10, 8)
  drop_lng     Decimal   @db.Decimal(11, 8)
  drop_status  String    @db.VarChar(50)
  drop_time    DateTime?
  drop_proof   String?   @db.VarChar(500)
  created_at   DateTime  @default(now())
  updated_at   DateTime
  delivery     delivery  @relation(fields: [delivery_id], references: [delivery_id], onDelete: Cascade)

  @@index([drop_status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model laundry_config {
  config_id         String   @id
  business_name     String   @db.VarChar(255)
  contact_email     String   @unique @db.VarChar(255)
  contact_phone     String   @db.VarChar(20)
  address           String
  latitude          Decimal  @db.Decimal(10, 8)
  longitude         Decimal  @db.Decimal(11, 8)
  service_radius_km Json
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime
  logo_url          String?
}

model order_item_selections {
  selection_id  String        @id
  order_item_id String
  cloth_id      String
  quantity      Int
  created_at    DateTime      @default(now())
  subtotal      Decimal       @db.Decimal(10, 2)
  unit_price    Decimal       @db.Decimal(10, 2)
  clothes_items clothes_items @relation(fields: [cloth_id], references: [cloth_id])
  order_items   order_items   @relation(fields: [order_item_id], references: [item_id], onDelete: Cascade)

  @@index([cloth_id])
  @@index([order_item_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model order_items {
  item_id               String                  @id
  order_id              String
  quantity              Int?
  subtotal              Decimal?                @db.Decimal(10, 2)
  created_at            DateTime                @default(now())
  order_item_status     OrderItemStatus         @default(assigned)
  updated_at            DateTime
  pricing_type          PricingModel
  service_id            String
  weight_kg             Decimal?                @db.Decimal(10, 2)
  order_item_selections order_item_selections[]
  orders                orders                  @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  services              services                @relation(fields: [service_id], references: [service_id])

  @@index([order_id])
  @@index([order_item_status])
  @@index([pricing_type])
  @@index([service_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model orders {
  order_id                                                          String             @id
  customer_id                                                       String
  total_amount                                                      Decimal?           @db.Decimal(10, 2)
  pickup_address_id                                                 String
  delivery_address_id                                               String
  special_instructions                                              String?
  created_at                                                        DateTime           @default(now())
  updated_at                                                        DateTime
  order_status                                                      OrderStatus
  order_type                                                        OrderType          @default(both)
  submitted_to_services_at                                          DateTime?
  pricing_model                                                     PricingModel
  billing_status                                                    BillingStatus      @default(pending)
  preferred_delivery_slot_from                                      DateTime?
  preferred_delivery_slot_to                                        DateTime?
  preferred_pickup_slot_from                                        DateTime?
  preferred_pickup_slot_to                                          DateTime?
  source_cart_id                                                    String?
  bills                                                             bills?
  customer_reviews                                                  customer_reviews?
  delivery                                                          delivery?
  order_items                                                       order_items[]
  customers                                                         customers          @relation(fields: [customer_id], references: [customer_id])
  customer_addresses_orders_delivery_address_idTocustomer_addresses customer_addresses @relation("orders_delivery_address_idTocustomer_addresses", fields: [delivery_address_id], references: [address_id])
  customer_addresses_orders_pickup_address_idTocustomer_addresses   customer_addresses @relation("orders_pickup_address_idTocustomer_addresses", fields: [pickup_address_id], references: [address_id])
  service_queue                                                     service_queue[]

  @@index([billing_status])
  @@index([created_at])
  @@index([customer_id])
  @@index([order_status])
  @@index([source_cart_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model otp_sessions {
  session_id              String   @id
  user_type               String   @db.VarChar(30)
  is_new_user             Boolean
  user_id                 String?
  session_token           String   @unique @db.VarChar(500)
  is_completed            Boolean  @default(false)
  expires_at              DateTime
  created_at              DateTime @default(now())
  email                   String   @db.VarChar(255)
  business_email          String?  @db.VarChar(255)
  business_email_verified Boolean  @default(false)

  @@index([email])
  @@index([expires_at])
  @@index([session_token])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model otp_verifications {
  otp_id       String   @id
  otp_code     String   @db.VarChar(6)
  user_type    String   @db.VarChar(30)
  is_verified  Boolean  @default(false)
  expires_at   DateTime
  created_at   DateTime @default(now())
  attempts     Int      @default(0)
  max_attempts Int      @default(5)
  purpose      String   @db.VarChar(50)
  email        String   @db.VarChar(255)

  @@index([email, purpose])
  @@index([expires_at])
  @@index([is_verified])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model pickup_for_delivery {
  pickup_id      String    @id
  delivery_id    String    @unique
  pickup_address String
  pickup_lat     Decimal   @db.Decimal(10, 8)
  pickup_lng     Decimal   @db.Decimal(11, 8)
  pickup_status  String    @db.VarChar(50)
  pickup_time    DateTime?
  pickup_proof   String?   @db.VarChar(500)
  created_at     DateTime  @default(now())
  updated_at     DateTime
  delivery       delivery  @relation(fields: [delivery_id], references: [delivery_id], onDelete: Cascade)

  @@index([pickup_status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model service_categories {
  category_id      String     @id
  category_name    String     @db.VarChar(100)
  description      String?
  icon_url         String?    @db.VarChar(500)
  display_order    Int        @default(0)
  is_active        Boolean    @default(true)
  created_at       DateTime   @default(now())
  updated_at       DateTime
  background_color String?    @db.VarChar(7)
  foreground_color String?    @db.VarChar(7)
  services         services[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model service_queue {
  queue_id       String      @id
  order_id       String
  service_id     String
  service_man_id String
  item_id        String
  item_name      String      @db.VarChar(255)
  quantity       Int
  queue_status   QueueStatus @default(pending)
  priority       Int         @default(0)
  assigned_at    DateTime    @default(now())
  started_at     DateTime?
  completed_at   DateTime?
  comments       String?
  created_at     DateTime    @default(now())
  updated_at     DateTime
  orders         orders      @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  services       services    @relation(fields: [service_id], references: [service_id])
  staff          staff       @relation(fields: [service_man_id], references: [staff_id])

  @@index([order_id])
  @@index([service_id, queue_status, priority])
  @@index([service_man_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model services {
  service_id         String             @id
  category_id        String
  service_name       String             @db.VarChar(255)
  description        String?
  base_price         Decimal            @db.Decimal(10, 2)
  per_kg_price       Decimal?           @db.Decimal(10, 2)
  estimated_hours    Int
  icon_url           String?            @db.VarChar(500)
  is_active          Boolean            @default(true)
  display_order      Int                @default(0)
  created_at         DateTime           @default(now())
  updated_at         DateTime
  cart_items         cart_items[]
  clothes_items      clothes_items[]
  order_items        order_items[]
  service_queue      service_queue[]
  service_categories service_categories @relation(fields: [category_id], references: [category_id])
  staff              staff?

  @@index([category_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model staff {
  staff_id      String          @id
  role          StaffRole
  full_name     String          @db.VarChar(255)
  email         String          @unique @db.VarChar(255)
  phone         String?         @db.VarChar(20)
  is_active     Boolean         @default(true)
  service_id    String?         @unique
  created_at    DateTime        @default(now())
  updated_at    DateTime
  service_queue service_queue[]
  services      services?       @relation(fields: [service_id], references: [service_id])

  @@index([role])
  @@index([service_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  user_id    String   @id
  full_name  String   @db.VarChar(255)
  email      String   @unique @db.VarChar(255)
  phone      String?  @db.VarChar(20)
  password   String?  @db.VarChar(255)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime
  role       UserRole @default(admin)

  @@index([role])
}

enum BillingStatus {
  pending
  generated
}

enum DeliveryType {
  pickup
  drop
}

enum OrderItemStatus {
  assigned
  on_process
  completed
}

enum OrderStatus {
  placed
  pickup_assigned
  picked_up
  received_by_collection
  submitted_to_services
  services_in_progress
  services_completed
  dispatch_assigned
  out_for_delivery
  payment_pending
  delivered
  closed
  cancelled
  draft
}

enum OrderType {
  pickup_only
  drop_only
  both
  express_delivery
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum PricingModel {
  per_unit
  per_kg
}

enum QueueStatus {
  pending
  in_progress
  completed
}

enum StaffRole {
  collection_manager
  distribution_manager
  service_man
}

enum UserRole {
  admin
  owner
}

enum VerificationStatus {
  pending
  verified
  rejected
}
