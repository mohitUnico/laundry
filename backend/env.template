# Database Configuration
# For local development:
DATABASE_URL="postgresql://postgres:admin@localhost:5432/laundry_db?connection_limit=10&pool_timeout=20"
# For Supabase (add connection pooling for better performance):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?connection_limit=10&pool_timeout=20&sslmode=require"
# Optional: Supabase managed Postgres connection (overrides DATABASE_URL when set)
# SUPABASE_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public&pgbouncer=true&connection_limit=1&sslmode=require"

# Supabase Realtime Configuration (for delivery staff location updates)
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
# SUPABASE_URL="https://your-project-id.supabase.co"
# SUPABASE_ANON_KEY="your-anon-public-key-here"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here" # Keep secret - backend only

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production-use-64-random-bytes"
JWT_EXPIRY="7d" # Access token expiry (7 days)

# Refresh Token Configuration
REFRESH_TOKEN_EXPIRY_DAYS=90 # Refresh token validity (90 days)
REFRESH_TOKEN_BYTES=48 # Random bytes for refresh token generation

# SMTP Email Configuration (required for sending OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Force real SMTP mode (must remain false for production)
MOCK_EMAIL=false
# Optional aliases / overrides
# EMAIL_SERVICE=gmail
FROM_EMAIL="Laundry App <your-email@gmail.com>"
# SMTP_FROM_EMAIL overrides FROM_EMAIL when provided

# Server Configuration
PORT=5000
NODE_ENV=development

# Logging Configuration
LOG_LEVEL=debug

# Firebase (FCM) - Push Notifications
# Enable Firebase Admin for sending push notifications to mobile apps
FIREBASE_ENABLED=false
# Path to Firebase service account JSON file (relative to backend/ root, or absolute)
# Example: FIREBASE_SERVICE_ACCOUNT_PATH="src/config/firebase-service-account.json"
# Example: FIREBASE_SERVICE_ACCOUNT_PATH="src/config/laundry-app-db266-firebase-adminsdk-xxxxx.json"
FIREBASE_SERVICE_ACCOUNT_PATH="src/config/firebase-service-account.json"

# CORS Configuration (comma-separated origins)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Twilio SMS Configuration (Optional - for OTP SMS)
# Sign up at: https://www.twilio.com/try-twilio
# Get credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+919876543210

# WhatsApp Notifications (order updates) - see docs/WHATSAPP_SETUP.md
WHATSAPP_ENABLED=false
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_ORDER_UPDATE_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternative: MSG91 for India (cheaper option)
# MSG91_AUTH_KEY=your_api_key
# MSG91_SENDER_ID=LNDRYAPP
# MSG91_TEMPLATE_ID=your_template_id

# AWS S3 Configuration (for file uploads)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=laundry-app-uploads

# OTP Configuration (optional - uses defaults if not set)
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_SECONDS=60

# Portal Login OTP Configuration (optional)
PORTAL_OTP_EXPIRY_MINUTES=5
PORTAL_OTP_CLEANUP_INTERVAL_MS=300000

# Pickup assignment job (polling mode)
# Leave unset or false to use in-process polling; set true to use DB webhook/pg_cron instead
# USE_WEBHOOK_PICKUP_ASSIGNMENT=false
# PICKUP_ASSIGNMENT_JOB_ENABLED=true
# Interval between two job runs: 120000 = 2 minutes (default)
PICKUP_ASSIGNMENT_JOB_INTERVAL_MS=600000
# Max orders to process per run (default 1 = each staff gets at most one request per 2 min)
# PICKUP_ASSIGNMENT_MAX_ORDERS_PER_RUN=1
# PICKUP_ASSIGNMENT_DEBUG=false
# When true, only pickup assignment job logs are printed to the console (all other logs suppressed)
# LOG_ONLY_PICKUP_ASSIGNMENT=true
# Transaction timeout for createAssignmentRequest (default 20000 ms). Increase if many staff or slow DB.
# DELIVERY_ASSIGNMENT_TX_TIMEOUT_MS=20000
# DELIVERY_ASSIGNMENT_TX_MAX_WAIT_MS=10000

# Scheduled jobs
# Set to false to disable the daily metrics job (rollup + backfill)
# DAILY_METRICS_JOB_ENABLED=false
# Set to false to disable only daily metrics logs (calculation still runs)
# DAILY_METRICS_LOGS_ENABLED=false

